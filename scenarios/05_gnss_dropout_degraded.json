  "expect": [
    {"check": "fault_raised", "fault": "GnssInvalid", "from_s": 50, "within_s": 0.5},
    {"check": "speed_between", "max_kph": 20.5, "from_s": 70, "to_s": 90},
    {"check": "speed_settles", "target_kph": 35, "tolerance_kph": 0.6, "from_s": 130},
    {"check": "estimate_error", "limit_kph": 0.6, "from_s": 1},
    {"check": "fault_never", "fault": "any_critical", "from_s": 1}
  ]
}
