    {"check": "state_never", "state": "SAFE_STOP", "from_s": 0, "to_s": 100},
    {"check": "speed_between", "max_kph": 20.5, "from_s": 70, "to_s": 100},
    {"check": "estimate_error", "limit_kph": 1.0, "from_s": 1, "to_s": 100},
    {"check": "state_reached", "state": "SAFE_STOP", "from_s": 100, "within_s": 0.6},
    {"check": "stopped_by", "by_s": 115},
    {"check": "max_decel", "limit_mps2": 1.3}
  ]
